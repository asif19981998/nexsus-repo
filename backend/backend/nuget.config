<?xml version="1.0" encoding="utf-8"?>
<!-- Pin the package source in the repo so restore works for any account
     (the CI runner runs as LocalSystem, whose profile has no NuGet sources). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
